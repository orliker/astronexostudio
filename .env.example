# Copy this file to .env.local and fill in only the values you actually use.
# The marketing site does NOT require any of these to run or build.
# Do not commit real secrets — .env* is gitignored except for this example.

# Optional: only needed if you wire up Gemini features locally.
# GEMINI_API_KEY=your_key_here

# Optional: public site URL used when generating absolute links.
# APP_URL=https://astronexo.studio
